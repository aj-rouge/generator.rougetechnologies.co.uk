    "@cloudflare/workers-types": "^4.20260619.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.5.0",
    "clean-css": "^5.3.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
