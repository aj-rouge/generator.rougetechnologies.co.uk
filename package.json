{
  "name": "ebay-desc-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:css": "node scripts/build-css.js",
    "build": "npm run build:css && next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build-and-run": "npx @opennextjs/cloudflare build && npx wrangler dev --remote",
    "dev:worker": "nodemon --watch app --watch components --ext ts,tsx,css --exec \"npm run build-and-run\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.7",
    "@types/papaparse": "^5.5.2",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "bolt-table": "^0.1.52",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.4",
    "framer-motion": "^12.0.0",
    "jose": "^6.2.2",
    "js-beautify": "^1.15.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.23.26",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.18.11",
    "sharp": "^0.34.5",
    "styled-jsx": "^5.1.7",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0"
  },
