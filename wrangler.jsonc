{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "d5904b41723d90ba536b9364cf3570c7",
  "main": ".open-next/worker.js",
  "name": "generator-rougetechnologies",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "generator-rougetechnologies",
    },
  ],
  "r2_buckets": [
    // Use R2 incremental cache
    // See https://opennext.js.org/cloudflare/caching
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      // Create the bucket before deploying
      // You can change the bucket name if you want
      // See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
      "bucket_name": "ebay-desc-generator-opennext-cache",
    },
    {
      "binding": "UPLOADS_BUCKET",
      "bucket_name": "rougetechnologies", // Put your actual production bucket name here
    },
  ],
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ebay-html-generator-search",
      "database_id": "90375842-d682-4918-87e4-d5c134a13bbb",
    },
  ],
}
